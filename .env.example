# Copy to .env and fill in. NEVER commit .env
# Multiple keys are round-robined by arbiter.llm.router to stretch free-tier RPD.
ARBITER_GEMINI_KEYS=key_gautam,key_chirag,key_aniket

# Reserved key used ONLY by the live demo, never by the experiment runner.
ARBITER_DEMO_KEY=key_reserved_for_demo

ARBITER_MODEL=gemini-flash-lite-latest
ARBITER_CACHE_DIR=.cache/llm
ARBITER_TRACE_DIR=traces
